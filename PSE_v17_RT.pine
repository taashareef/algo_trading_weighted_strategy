//@version=6
indicator("⬡ PSE v17 RT", shorttitle="⬡ PSE RT", overlay=true, max_labels_count=500, max_lines_count=500, max_bars_back=5000)

// ═══════════════════════════════════ INPUTS ══════════════════════════════════
string g1 = "⬡ Core"
int   i_buyMin   = input.int(3,   "Buy Min Score",    minval=2, maxval=8,  group=g1)
int   i_sellMin  = input.int(3,   "Sell Min Score",   minval=2, maxval=8,  group=g1)
int   i_cooldown = input.int(2,   "Cooldown (bars)",  minval=1, maxval=10, group=g1)
int   i_timeout  = input.int(20,  "Timeout (bars)",   minval=5, maxval=60, group=g1)

string g2 = "⬡ Risk"
float i_stopPct   = input.float(1.5, "Stop Loss %",     minval=0.3, maxval=5.0, step=0.1, group=g2)
float i_trailBase = input.float(2.5, "Trail ATR Base",  minval=1.0, maxval=5.0, step=0.1, group=g2)

string g3 = "⬡ Structure"
int   i_atrLen  = input.int(14,    "ATR Length",      minval=5,   maxval=50,  group=g3)
float i_stMult  = input.float(3.0, "ST Multiplier",   minval=1.0, maxval=6.0, step=0.1, group=g3)
float i_paraPct = input.float(20.0,"Parabolic %",     minval=10.0,maxval=40.0,step=1.0, group=g3)
int   i_adxLen  = input.int(14,    "ADX Length",      minval=7,   maxval=30,  group=g3)
int   i_adxChop = input.int(15,    "ADX Chop Level",  minval=10,  maxval=25,  group=g3)

string g3b = "⬡ MTF"
bool  i_useMTF  = input.bool(true, "Enable MTF Filter", group=g3b)
string i_mtfTF  = input.timeframe("", "MTF Timeframe (auto if empty)", group=g3b)

string g4 = "⬡ Style"
color cLong      = input.color(#48756e, "◆ Up",           group=g4)
color cShort     = input.color(#8f2b22, "◆ Down",         group=g4)
color cTgt       = input.color(#afafaf, "◆ Target",       group=g4)
color cEarly     = input.color(#d4a843, "◆ Early",        group=g4)
bool  i_showDash = input.bool(true,     "Show Dashboard", group=g4)
bool  i_showST   = input.bool(true,     "Show Supertrend",group=g4)
bool  i_barColor  = input.bool(true,    "Bar Coloring",   group=g4)

string g7 = "⬡ Alerts"
bool i_alerts = input.bool(true, "Enable Alerts", group=g7)

// ═══════════════════════════════════ CORE CALCULATIONS ═══════════════════════
float atr         = ta.atr(i_atrLen)
float rsi14       = ta.rsi(close, 14)
float atrPct      = close > 0 ? (atr / close) * 100.0 : 1.0
float bodySize    = math.abs(close - open)
float bodyLo      = math.min(open, close)
float bodyHi      = math.max(open, close)
float candleRange = high - low
float safeAtr     = math.max(atr, syminfo.mintick)

// ═══════════════════════════════════ ADX CHOP FILTER ═════════════════════════
float trVal   = ta.tr
float dmPlus  = high - high[1] > low[1] - low ? math.max(high - high[1], 0.0) : 0.0
float dmMinus = low[1] - low > high - high[1] ? math.max(low[1] - low, 0.0) : 0.0
float smTR    = ta.rma(trVal, i_adxLen)
float smPlus  = ta.rma(dmPlus, i_adxLen)
float smMinus = ta.rma(dmMinus, i_adxLen)
float diPlus  = smTR > 0 ? smPlus  / smTR * 100.0 : 0.0
float diMinus = smTR > 0 ? smMinus / smTR * 100.0 : 0.0
float dxVal   = (diPlus + diMinus) > 0 ? math.abs(diPlus - diMinus) / (diPlus + diMinus) * 100.0 : 0.0
float adxVal  = ta.rma(dxVal, i_adxLen)
bool  isChop  = adxVal < i_adxChop
int   chopPenalty = isChop ? 2 : 0

// ═══════════════════════════════════ VOLUME ══════════════════════════════════
float hlRange   = math.max(high - low, syminfo.mintick)
float buyVol    = volume * (close - low) / hlRange
float sellVol   = volume - buyVol
float normDelta = volume > 0 ? (buyVol - sellVol) / volume : 0.0
bool  bullDelta = normDelta >  0.05
bool  bearDelta = normDelta < -0.05
float volSMA    = ta.sma(volume, 20)
float volSTD    = ta.stdev(volume, 20)
float volZscore = volSTD > 0 ? (volume - volSMA) / volSTD : 0.0
bool  volSpike  = volZscore >= 1.5 or volume > volSMA * 2.0

// ═══════════════════════════════════ SUPERTREND (ADAPTIVE) ═══════════════════
float atrF = ta.sma(atr, 10)
float atrS = ta.sma(atr, 50)
float atrR = atrS > 0 ? atrF / atrS : 1.0
int   regime = atrR > 1.4 ? 2 : atrR < 0.9 ? 0 : 1
bool  isRanging = regime == 0
float adaptMult = regime == 2 ? math.min(i_stMult * atrR, i_stMult * 2.0) : regime == 0 ? i_stMult * 0.85 : i_stMult
[stValue, stRawDir] = ta.supertrend(adaptMult, 10)
int stDir = stRawDir == -1 ? 1 : -1

bool stFlipBull = stDir == 1  and stDir[1] == -1
bool stFlipBear = stDir == -1 and stDir[1] == 1

// ═══════════════════════════════════ MTF SUPERTREND ══════════════════════════
float  tfMin   = timeframe.in_seconds() / 60.0
string autoHTF = tfMin <= 1 ? "5" : tfMin <= 5 ? "15" : tfMin <= 15 ? "60" : tfMin <= 60 ? "240" : tfMin <= 240 ? "1D" : tfMin <= 1440 ? "1W" : "1M"
string mtfTF   = i_mtfTF == "" ? autoHTF : i_mtfTF
int    mtfDir  = 0
if i_useMTF
    [mtfST, mtfRaw] = request.security(syminfo.tickerid, mtfTF, ta.supertrend(i_stMult, 10), lookahead=barmerge.lookahead_off)
    mtfDir := mtfRaw == -1 ? 1 : -1

// ═══════════════════════════════════ ZIGZAG (structure scoring only) ═════════
float zzDepth = math.max(atrPct * 3.0, 0.5)
var float zzH  = high
var float zzL  = low
var int   zzHB = bar_index
var int   zzLB = bar_index
var int   zzD  = 0
var float lastSwHi    = na
var float lastSwLo    = na
var int   lastSwHiBar = na
var int   lastSwLoBar = na
var float pSwHi2 = na
var float pSwLo2 = na

if high > zzH
    zzH  := high
    zzHB := bar_index
if low < zzL
    zzL  := low
    zzLB := bar_index

bool  swH    = false
bool  swL    = false
float revPct = zzDepth / 100.0

if zzD >= 0
    float dr = zzH > 0 ? (zzH - low) / zzH : 0.0
    if dr >= revPct and (bar_index - zzHB) >= 2
        swH         := true
        pSwHi2      := lastSwHi
        lastSwHi    := zzH
        lastSwHiBar := zzHB
        zzD  := -1
        zzL  := low
        zzLB := bar_index

if zzD <= 0
    float ri = zzL > 0 ? (high - zzL) / zzL : 0.0
    if ri >= revPct and (bar_index - zzLB) >= 2
        swL         := true
        pSwLo2      := lastSwLo
        lastSwLo    := zzL
        lastSwLoBar := zzLB
        zzD  := 1
        zzH  := high
        zzHB := bar_index

bool zzBull = not na(pSwLo2) and lastSwLo > pSwLo2
bool zzBear = not na(pSwHi2) and lastSwHi < pSwHi2

// ═══════════════════════════════════ RSI DIVERGENCE ══════════════════════════
var float pLP = na, var float pLR = na, var float cLP = na, var float cLR = na
var float pHP = na, var float pHR = na, var float cHP = na, var float cHR = na

if swL
    pLP := cLP, pLR := cLR
    cLP := lastSwLo
    cLR := ta.lowest(rsi14, math.max(bar_index - lastSwLoBar + 1, 1))
if swH
    pHP := cHP, pHR := cHR
    cHP := lastSwHi
    cHR := ta.highest(rsi14, math.max(bar_index - lastSwHiBar + 1, 1))

bool bullDiv = swL and not na(pLP) and ((cLP < pLP and cLR > pLR) or (cLP > pLP and cLR < pLR)) and math.abs(cLR - pLR) > 2.0
bool bearDiv = swH and not na(pHP) and ((cHP > pHP and cHR < pHR) or (cHP < pHP and cHR > pHR)) and math.abs(cHR - pHR) > 2.0

var int lBDBar = -9999, var int lSDBar = -9999
if bullDiv
    lBDBar := bar_index
if bearDiv
    lSDBar := bar_index
bool rBullDiv = (bar_index - lBDBar) <= 5
bool rBearDiv = (bar_index - lSDBar) <= 5

// ═══════════════════════════════════ SWEEP + ANTI-TRAP ═══════════════════════
int   lookback  = 14
float recentLo  = ta.lowest(low, lookback)[1]
float recentHi  = ta.highest(high, lookback)[1]
bool  sweepLoRaw = low < recentLo and close > recentLo and (close > open or volume > volSMA)
bool  sweepHiRaw = high > recentHi and close < recentHi and (close < open or volume > volSMA)

var bool  pendingSweepLo = false
var bool  pendingSweepHi = false
var float sweepLoLevel   = na
var float sweepHiLevel   = na
bool sweepLo = false
bool sweepHi = false

if sweepLoRaw
    pendingSweepLo := true
    sweepLoLevel   := recentLo
if sweepHiRaw
    pendingSweepHi := true
    sweepHiLevel   := recentHi

if pendingSweepLo and not sweepLoRaw
    bool holdAbove = close > nz(sweepLoLevel, close) and close > open
    bool volDryUp  = volume < volSMA * 0.7
    if holdAbove or volDryUp
        sweepLo := true
    pendingSweepLo := false
    sweepLoLevel   := na

if pendingSweepHi and not sweepHiRaw
    bool holdBelow = close < nz(sweepHiLevel, close) and close < open
    bool volDryUp2 = volume < volSMA * 0.7
    if holdBelow or volDryUp2
        sweepHi := true
    pendingSweepHi := false
    sweepHiLevel   := na

// ═══════════════════════════════════ ORDER BLOCKS ════════════════════════════
int   obLen = 5
float obHi  = ta.highest(high, obLen)
float obLo  = ta.lowest(low, obLen)
var float obBullZone = na, var float obBearZone = na
var int   obBullAge  = 0, var int   obBearAge  = 0

if close > obHi[1] and close[1] <= obHi[1]
    for i = 1 to obLen
        if close[i] < open[i]
            obBullZone := low[i]
            obBullAge  := 0
            break
if close < obLo[1] and close[1] >= obLo[1]
    for i = 1 to obLen
        if close[i] > open[i]
            obBearZone := high[i]
            obBearAge  := 0
            break

obBullAge += 1
obBearAge += 1
bool inBullOB = not na(obBullZone) and low  <= obBullZone + atr and close > obBullZone and obBullAge < 40
bool inBearOB = not na(obBearZone) and high >= obBearZone - atr and close < obBearZone and obBearAge < 40

// ═══════════════════════════════════ CANDLE PATTERNS ═════════════════════════
float avgBody20 = ta.sma(bodySize, 20)
float uShadow   = high - bodyHi
float lShadow   = bodyLo - low
float trendSlope = close - close[3]

bool bullEng  = close[1] < open[1] and close > open and close > open[1] and open < close[1] and bodySize > avgBody20
bool bearEng  = close[1] > open[1] and close < open and open > close[1] and close < open[1] and bodySize > avgBody20
bool isHammer = candleRange > 0 and lShadow >= bodySize * 2.0 and uShadow <= candleRange * 0.15 and bodySize < candleRange * 0.35
bool isShStar = candleRange > 0 and uShadow >= bodySize * 2.0 and lShadow <= candleRange * 0.15 and bodySize < candleRange * 0.35
float firstMid  = (close[2] + open[2]) / 2.0
float prevBody1 = math.abs(close[1] - open[1])
bool isMStar = close[2] < open[2] and prevBody1 < candleRange * 0.3 and close > open and close > firstMid and trendSlope < 0
bool isEStar = close[2] > open[2] and prevBody1 < candleRange * 0.3 and close < open and close < firstMid and trendSlope > 0
bool strongBullPattern = (bullEng and volSpike) or isMStar
bool strongBearPattern = (bearEng and volSpike) or isEStar

// ═══════════════════════════════════ DISPLACEMENT ════════════════════════════
float rangeMean  = ta.sma(candleRange, 50)
float rangeStdev = ta.stdev(candleRange, 50)
float bodyRatio  = candleRange > 0 ? bodySize / candleRange : 0.0
bool  bullDisp   = close > open and candleRange > rangeMean + rangeStdev * 1.5 and bodyRatio > 0.25
bool  bearDisp   = close < open and candleRange > rangeMean + rangeStdev * 1.5 and bodyRatio > 0.25

// ═══════════════════════════════════ EXHAUSTION ══════════════════════════════
float lo20   = ta.lowest(low, 20)
float hi20   = ta.highest(high, 20)
float rise20 = (high - lo20) / math.max(lo20, 1) * 100.0
float drop20 = (hi20 - low)  / math.max(hi20, 1) * 100.0
bool  exhTop = rise20 > i_paraPct and close < open and close[1] > open[1]
bool  exhBot = drop20 > i_paraPct and close > open and close[1] < open[1]

// ═══════════════════════════════════ REAL-TIME TRIGGERS ══════════════════════
// v17 RT: real-time conditions replace the delayed ZigZag gate
// Any of these can independently trigger scoring evaluation
bool buyTrigger  = stFlipBull or strongBullPattern or exhBot or sweepLo or (inBullOB and bullDelta) or bullDisp or (isHammer and rsi14 < 45) or rBullDiv
bool sellTrigger = stFlipBear or strongBearPattern or exhTop or sweepHi or (inBearOB and bearDelta) or bearDisp or (isShStar and rsi14 > 55) or rBearDiv

// ═══════════════════════════════════ SCORING ═════════════════════════════════
int bSc = 0
if buyTrigger
    bSc := 1
    if stDir == 1
        bSc += 2
    else
        bSc -= 2
    if i_useMTF and mtfDir == 1
        bSc += 2
    else if i_useMTF and mtfDir == -1
        bSc -= 2
    if rsi14 < 30
        bSc += 2
    else if rsi14 < 40
        bSc += 1
    if rsi14 > 45 and rsi14 < 55
        bSc -= 1
    if rBullDiv
        bSc += 3
    if bullDelta and volSpike
        bSc += 1
    else if bullDelta
        bSc += 1
    if sweepLo or sweepLo[1]
        bSc += 2
    if inBullOB
        bSc += 1
    if bullEng or bullEng[1]
        bSc += 1
    if isHammer
        bSc += 1
    if isMStar
        bSc += 1
    if bullDisp or bullDisp[1]
        bSc += 1
    if zzBull
        bSc += 1
    if exhBot
        bSc += 1
    if stFlipBull
        bSc += 1
    bSc -= chopPenalty
    if isRanging
        bSc -= 1
    bSc := math.max(bSc, 0)

int sSc = 0
if sellTrigger
    sSc := 1
    if stDir == -1
        sSc += 2
    else
        sSc -= 2
    if i_useMTF and mtfDir == -1
        sSc += 2
    else if i_useMTF and mtfDir == 1
        sSc -= 2
    if rsi14 > 70
        sSc += 2
    else if rsi14 > 60
        sSc += 1
    if rsi14 > 45 and rsi14 < 55
        sSc -= 1
    if rBearDiv
        sSc += 3
    if bearDelta and volSpike
        sSc += 1
    else if bearDelta
        sSc += 1
    if sweepHi or sweepHi[1]
        sSc += 2
    if inBearOB
        sSc += 1
    if bearEng or bearEng[1]
        sSc += 1
    if isShStar
        sSc += 1
    if isEStar
        sSc += 1
    if bearDisp or bearDisp[1]
        sSc += 1
    if zzBear
        sSc += 1
    if exhTop
        sSc += 1
    if stFlipBear
        sSc += 1
    sSc -= chopPenalty
    if isRanging
        sSc -= 1
    sSc := math.max(sSc, 0)

// ═══════════════════════════════════ DUAL SIGNAL SYSTEM ═════════════════════
var int lastSigBar   = -9999
var int lastEarlyBar = -9999
int earlyThreshold   = math.max(i_buyMin + 3, 6)

bool earlyBuy  = buyTrigger  and bSc >= earlyThreshold and not barstate.isconfirmed and (bar_index - lastEarlyBar >= i_cooldown) and (bar_index - lastSigBar >= i_cooldown)
bool earlySell = sellTrigger and sSc >= earlyThreshold and not barstate.isconfirmed and (bar_index - lastEarlyBar >= i_cooldown) and (bar_index - lastSigBar >= i_cooldown)
if earlyBuy or earlySell
    lastEarlyBar := bar_index

bool sigBuy  = buyTrigger  and bSc >= i_buyMin  and barstate.isconfirmed and (bar_index - lastSigBar >= i_cooldown)
bool sigSell = sellTrigger and sSc >= i_sellMin and barstate.isconfirmed and (bar_index - lastSigBar >= i_cooldown)

if sigBuy and sigSell
    if bSc >= sSc
        sigSell := false
    else
        sigBuy := false

if sigBuy or sigSell
    lastSigBar := bar_index

string buyGrade  = bSc >= 10 ? "S" : bSc >= 7 ? "A" : bSc >= 5 ? "B" : "C"
string sellGrade = sSc >= 10 ? "S" : sSc >= 7 ? "A" : sSc >= 5 ? "B" : "C"

// ═══════════════════════════════════ ADAPTIVE EXIT ═══════════════════════════
var string posDir     = "none"
var float  entryPrice = na
var int    entryBar   = na
var int    entrySc    = 0
var float  trailLevel = na
var float  peakPrice  = na
var float  peakPnL    = 0.0

float trailMult     = entrySc >= 8 ? i_trailBase + 0.5 : entrySc <= 4 ? math.max(i_trailBase - 1.0, 1.0) : i_trailBase
float profitTighten = peakPnL >= 4.0 ? 0.8 : peakPnL >= 2.0 ? 0.5 : peakPnL >= 1.0 ? 0.2 : 0.0
float finalTrail    = math.max(trailMult - profitTighten, 0.8)

bool   exitSignal = false
string exitReason = ""

if posDir == "long" and not na(entryPrice)
    peakPrice  := math.max(nz(peakPrice, high), high)
    float unrealPnL = (close - entryPrice) / entryPrice * 100.0
    peakPnL    := math.max(peakPnL, unrealPnL)
    trailLevel := peakPrice - atr * finalTrail
    int dur = bar_index - nz(entryBar, bar_index)
    if sigSell or close <= trailLevel or unrealPnL <= -i_stopPct or dur >= i_timeout
        exitSignal := true
        exitReason := sigSell ? "signal" : close <= trailLevel ? "trail" : unrealPnL <= -i_stopPct ? "stop" : "timeout"

if posDir == "short" and not na(entryPrice)
    peakPrice  := math.min(nz(peakPrice, low), low)
    float unrealPnL = (entryPrice - close) / entryPrice * 100.0
    peakPnL    := math.max(peakPnL, unrealPnL)
    trailLevel := peakPrice + atr * finalTrail
    int dur2 = bar_index - nz(entryBar, bar_index)
    if sigBuy or close >= trailLevel or unrealPnL <= -i_stopPct or dur2 >= i_timeout
        exitSignal := true
        exitReason := sigBuy ? "signal" : close >= trailLevel ? "trail" : unrealPnL <= -i_stopPct ? "stop" : "timeout"

// ═══════════════════════════════════ EXIT + P&L + ENTRY ═════════════════════
var float lastClosedPnL = na
var float tgt1 = na, var float tgt2 = na
var line  tgtLine1 = na, var line  tgtLine2 = na
var label tgtLbl1  = na, var label tgtLbl2  = na
color cInfo = #948d8d

if exitSignal and posDir != "none"
    if posDir == "long"
        lastClosedPnL := (close - entryPrice) / entryPrice * 100.0
    else
        lastClosedPnL := (entryPrice - close) / entryPrice * 100.0
    if exitReason != "signal"
        string exLbl = exitReason == "trail" ? "▣T" : exitReason == "stop" ? "▣S" : "▣TO"
        color  exClr = exitReason == "stop" ? cShort : cTgt
        if posDir == "long"
            label.new(bar_index, high + safeAtr * 0.2, exLbl, style=label.style_label_down, color=color.new(exClr, 30), textcolor=color.white, size=size.tiny)
        else
            label.new(bar_index, low - safeAtr * 0.2, exLbl, style=label.style_label_up, color=color.new(exClr, 30), textcolor=color.white, size=size.tiny)
    line.delete(tgtLine1),  line.delete(tgtLine2)
    label.delete(tgtLbl1), label.delete(tgtLbl2)
    tgt1 := na, tgt2 := na
    posDir     := "none"
    entryPrice := na
    entryBar   := na
    entrySc    := 0
    trailLevel := na
    peakPrice  := na
    peakPnL    := 0.0

if posDir == "none" and sigBuy
    posDir     := "long"
    entryPrice := close
    entryBar   := bar_index
    peakPrice  := high
    entrySc    := bSc
    peakPnL    := 0.0

if posDir == "none" and sigSell
    posDir     := "short"
    entryPrice := close
    entryBar   := bar_index
    peakPrice  := low
    entrySc    := sSc
    peakPnL    := 0.0

// ═══════════════════════════════════ LABELS + TARGETS ════════════════════════
if earlyBuy
    label.new(bar_index, low - safeAtr * 0.3, "⚡", style=label.style_label_up, color=color.new(cEarly, 20), textcolor=color.white, size=size.tiny)
if earlySell
    label.new(bar_index, high + safeAtr * 0.3, "⚡", style=label.style_label_down, color=color.new(cEarly, 20), textcolor=color.white, size=size.tiny)

if sigBuy
    string stars  = bSc >= 10 ? "✦✦✦" : bSc >= 7 ? "✦✦" : bSc >= 5 ? "✦" : ""
    string pnlTxt = not na(lastClosedPnL) ? " " + (lastClosedPnL >= 0 ? "+" : "") + str.tostring(lastClosedPnL, "#.##") + "%" : ""
    string lbl    = "◆" + stars + str.tostring(bSc) + pnlTxt
    label.new(bar_index, low - safeAtr * 0.3, lbl, style=label.style_label_up, color=color.new(cLong, 10), textcolor=cInfo, size=size.tiny)
    lastClosedPnL := na
    line.delete(tgtLine1),  line.delete(tgtLine2)
    label.delete(tgtLbl1), label.delete(tgtLbl2)
    float t1 = close + safeAtr * 1.5
    float t2 = close + safeAtr * 3.0
    if not na(lastSwHi) and lastSwHi > close
        t1 := (close + lastSwHi) * 0.5
        t2 := lastSwHi
    if t1 <= close
        t1 := close + safeAtr * 1.0
    if t2 <= close
        t2 := close + safeAtr * 2.5
    tgt1 := t1
    tgt2 := t2
    int x2   = bar_index + 15
    tgtLine1 := line.new(bar_index, t1, x2, t1, color=color.new(cLong, 50), style=line.style_dashed, width=1)
    tgtLbl1  := label.new(x2, t1, "⬡ " + str.tostring(t1, format.mintick), color=color.new(color.black, 100), textcolor=color.new(cLong, 30), style=label.style_label_left, size=size.tiny)
    tgtLine2 := line.new(bar_index, t2, x2, t2, color=color.new(cLong, 50), style=line.style_dashed, width=1)
    tgtLbl2  := label.new(x2, t2, "⬡ " + str.tostring(t2, format.mintick), color=color.new(color.black, 100), textcolor=color.new(cLong, 30), style=label.style_label_left, size=size.tiny)

if sigSell
    string stars  = sSc >= 10 ? "✦✦✦" : sSc >= 7 ? "✦✦" : sSc >= 5 ? "✦" : ""
    string pnlTxt = not na(lastClosedPnL) ? " " + (lastClosedPnL >= 0 ? "+" : "") + str.tostring(lastClosedPnL, "#.##") + "%" : ""
    string lbl    = "◆" + stars + str.tostring(sSc) + pnlTxt
    label.new(bar_index, high + safeAtr * 0.3, lbl, style=label.style_label_down, color=color.new(cShort, 10), textcolor=cInfo, size=size.tiny)
    lastClosedPnL := na
    line.delete(tgtLine1),  line.delete(tgtLine2)
    label.delete(tgtLbl1), label.delete(tgtLbl2)
    float t1 = close - safeAtr * 1.5
    float t2 = close - safeAtr * 3.0
    if not na(lastSwLo) and lastSwLo < close
        t1 := (close + lastSwLo) * 0.5
        t2 := lastSwLo
    if t1 >= close
        t1 := close - safeAtr * 1.0
    if t2 >= close
        t2 := close - safeAtr * 2.5
    tgt1 := t1
    tgt2 := t2
    int x2   = bar_index + 15
    tgtLine1 := line.new(bar_index, t1, x2, t1, color=color.new(cShort, 50), style=line.style_dashed, width=1)
    tgtLbl1  := label.new(x2, t1, "⬡ " + str.tostring(t1, format.mintick), color=color.new(color.black, 100), textcolor=color.new(cShort, 30), style=label.style_label_left, size=size.tiny)
    tgtLine2 := line.new(bar_index, t2, x2, t2, color=color.new(cShort, 50), style=line.style_dashed, width=1)
    tgtLbl2  := label.new(x2, t2, "⬡ " + str.tostring(t2, format.mintick), color=color.new(color.black, 100), textcolor=color.new(cShort, 30), style=label.style_label_left, size=size.tiny)

// ═══════════════════════════════════ SUPERTREND PLOT ═════════════════════════
plot(i_showST ? stValue : na, "Supertrend", color=stDir == 1 ? cLong : cShort, linewidth=2, style=plot.style_linebr)

// ═══════════════════════════════════ BAR COLORING ═══════════════════════════
barcolor(i_barColor and posDir == "long" ? color.new(cLong, 60) : i_barColor and posDir == "short" ? color.new(cShort, 60) : na)

// ═══════════════════════════════════ DASHBOARD ═══════════════════════════════
getGrade(int sc) =>
    sc >= 10 ? "S" : sc >= 7 ? "A" : sc >= 5 ? "B+" : sc >= 3 ? "B" : "C"

var table dash = na
if i_showDash and na(dash)
    dash := table.new(position.top_right, 2, 10, bgcolor=color.new(#0d1117, 0), border_width=1, border_color=color.new(#30363d, 0), frame_width=2, frame_color=color.new(cLong, 50))

if i_showDash and barstate.islast and not na(dash)
    int r = 0
    table.cell(dash, 0, r, "⬡ PSE v17 RT", text_color=cLong, text_size=size.small, bgcolor=color.new(#161b22, 0))
    table.merge_cells(dash, 0, r, 1, r)
    r += 1
    color posClr = posDir == "long" ? cLong : posDir == "short" ? cShort : color.gray
    table.cell(dash, 0, r, "Pos:", text_color=color.silver, text_size=size.small, bgcolor=color.new(#161b22, 0))
    table.cell(dash, 1, r, posDir == "long" ? "LONG" : posDir == "short" ? "SHORT" : "FLAT", text_color=posClr, text_size=size.small, bgcolor=color.new(#161b22, 0))
    r += 1
    if posDir != "none" and not na(entryPrice)
        float dPnL = posDir == "long" ? (close - entryPrice) / entryPrice * 100.0 : (entryPrice - close) / entryPrice * 100.0
        table.cell(dash, 0, r, "P&L:", text_color=color.silver, text_size=size.small, bgcolor=color.new(#161b22, 0))
        table.cell(dash, 1, r, str.tostring(dPnL, "#.##") + "%", text_color=dPnL >= 0 ? cLong : cShort, text_size=size.small, bgcolor=color.new(#161b22, 0))
        r += 1
        table.cell(dash, 0, r, "Grade:", text_color=color.silver, text_size=size.small, bgcolor=color.new(#161b22, 0))
        table.cell(dash, 1, r, str.tostring(entrySc) + " " + getGrade(entrySc), text_color=color.white, text_size=size.small, bgcolor=color.new(#161b22, 0))
        r += 1
        if not na(trailLevel)
            table.cell(dash, 0, r, "Trail:", text_color=color.silver, text_size=size.small, bgcolor=color.new(#161b22, 0))
            table.cell(dash, 1, r, str.tostring(trailLevel, format.mintick), text_color=cTgt, text_size=size.small, bgcolor=color.new(#161b22, 0))
            r += 1
        table.cell(dash, 0, r, "Bars:", text_color=color.silver, text_size=size.small, bgcolor=color.new(#161b22, 0))
        table.cell(dash, 1, r, str.tostring(bar_index - nz(entryBar, bar_index)) + "/" + str.tostring(i_timeout), text_color=color.white, text_size=size.small, bgcolor=color.new(#161b22, 0))
        r += 1
    table.cell(dash, 0, r, "ST:", text_color=color.silver, text_size=size.small, bgcolor=color.new(#161b22, 0))
    string stTxt = stDir == 1 ? "BULL" : "BEAR"
    if i_useMTF
        stTxt += mtfDir == 1 ? " | HTF▲" : mtfDir == -1 ? " | HTF▼" : " | HTF—"
    table.cell(dash, 1, r, stTxt, text_color=stDir == 1 ? cLong : cShort, text_size=size.small, bgcolor=color.new(#161b22, 0))
    r += 1
    table.cell(dash, 0, r, "ADX:", text_color=color.silver, text_size=size.small, bgcolor=color.new(#161b22, 0))
    table.cell(dash, 1, r, str.tostring(adxVal, "#.#") + (isChop ? " CHOP" : ""), text_color=isChop ? color.orange : color.white, text_size=size.small, bgcolor=color.new(#161b22, 0))
    r += 1
    table.cell(dash, 0, r, "RSI:", text_color=color.silver, text_size=size.small, bgcolor=color.new(#161b22, 0))
    table.cell(dash, 1, r, str.tostring(rsi14, "#.#"), text_color=rsi14 < 30 ? cLong : rsi14 > 70 ? cShort : color.white, text_size=size.small, bgcolor=color.new(#161b22, 0))

// ═══════════════════════════════════ ALERTS ══════════════════════════════════
alertcondition(sigBuy,    title="⬡ Long",        message="⬡ PSE RT: Long · {{ticker}} {{interval}}")
alertcondition(sigSell,   title="⬡ Short",       message="⬡ PSE RT: Short · {{ticker}} {{interval}}")
alertcondition(earlyBuy,  title="⬡ Early Long",  message="⬡ PSE RT: ⚡Early Long · {{ticker}} {{interval}}")
alertcondition(earlySell, title="⬡ Early Short", message="⬡ PSE RT: ⚡Early Short · {{ticker}} {{interval}}")
alertcondition(exitSignal and exitReason == "stop",  title="⬡ Stop",  message="⬡ PSE RT: Stop · {{ticker}}")
alertcondition(exitSignal and exitReason == "trail", title="⬡ Trail", message="⬡ PSE RT: Trail · {{ticker}}")

if i_alerts and earlyBuy
    alert("⚡ PSE RT Early Long · " + syminfo.ticker + " " + timeframe.period + " · sc:" + str.tostring(bSc) + " " + buyGrade, alert.freq_once_per_bar)
if i_alerts and earlySell
    alert("⚡ PSE RT Early Short · " + syminfo.ticker + " " + timeframe.period + " · sc:" + str.tostring(sSc) + " " + sellGrade, alert.freq_once_per_bar)
if i_alerts and sigBuy
    alert("⬡ PSE RT Long · " + syminfo.ticker + " " + timeframe.period + " · sc:" + str.tostring(bSc) + " " + buyGrade, alert.freq_once_per_bar_close)
if i_alerts and sigSell
    alert("⬡ PSE RT Short · " + syminfo.ticker + " " + timeframe.period + " · sc:" + str.tostring(sSc) + " " + sellGrade, alert.freq_once_per_bar_close)

plot(buyTrigger  ? bSc : na, "Buy Score",  display=display.none)
plot(sellTrigger ? sSc : na, "Sell Score", display=display.none)
